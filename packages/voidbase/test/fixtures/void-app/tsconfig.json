{
  "extends": "./.voidbase/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": [
      "void/env"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db"
  ]
}
