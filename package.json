{
  "name": "voidbase",
  "version": "0.1.0",
  "description": "PocketBase-wire-compatible backend on Cloudflare Workers via Void",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "voidbase": "bin/voidbase.ts"
  },
  "exports": {
    "./app": "./src/server/app.ts",
    "./crons": "./src/server/crons.ts",
    "./plugin": "./hooks-plugin.ts",
    "./middleware": "./middleware/01.request-context.ts",
    "./schema": "./db/schema.ts",
    "./env": "./env.ts",
    "./scripts/*": "./scripts/*",
    "./db/migrations/*": "./db/migrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "db",
    "crons",
    "middleware",
    "routes",
    "scripts",
    "docs",
    "hooks-plugin.ts",
    "vite.config.ts",
    "void.json",
    "env.ts",
    "tsconfig.json",
    ".env.example",
    "README.md",
    "COMPAT.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "pocketbase",
    "cloudflare-workers",
    "d1",
    "r2",
    "void",
    "backend",
    "baas"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "panel:sync": "bun scripts/sync-panel.ts",
    "surface": "bun surface/render.ts",
    "test": "bun test",
    "app:sync": "bun scripts/sync-app.ts"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@simplewebauthn/server": "^14.0.1",
    "bcryptjs": "^3.0.2",
    "fflate": "^0.8.3",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250903.0",
    "playwright": "^1.63.0",
    "pocketbase": "0.28.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-plus": "^0.1.21",
    "void": "^0.10.13"
  }
}
