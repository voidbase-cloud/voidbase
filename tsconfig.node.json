{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun-types",
      "@cloudflare/workers-types"
    ],
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src/node",
    "src/platform/node",
    "src/server",
    "hooks-plugin.ts",
    "bin",
    "src/adapter"
  ]
}
