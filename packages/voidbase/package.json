{
  "name": "@voidbase-cloud/voidbase",
  "version": "0.9.0-beta.56",
  "description": "PocketBase-compatible backend on Cloudflare Workers (D1, R2, Queues, Durable Objects) via Void, or a single Bun process",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidbase-cloud/voidbase.git"
  },
  "homepage": "https://github.com/voidbase-cloud/voidbase#readme",
  "bugs": {
    "url": "https://github.com/voidbase-cloud/voidbase/issues"
  },
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "voidbase": "bin/voidbase.ts"
  },
  "exports": {
    ".": "./src/node/index.ts",
    "./adapter": "./src/adapter/runtime.ts",
    "./adapter/plugin": "./src/adapter/index.ts",
    "./api": "./src/server/api.ts",
    "./app": "./src/server/app.ts",
    "./auth-routes": "./src/server/entries/auth-routes.ts",
    "./auth-slot": "./src/server/auth-slot.ts",
    "./backups-api": "./src/server/entries/backups-api.ts",
    "./bundle": "./src/node/bundle.ts",
    "./cloud": "./src/cloud/rest.ts",
    "./cloud-client": "./src/cloud/client.ts",
    "./crons": "./src/server/crons.ts",
    "./deploy-plugin": "./src/node/deploy-plugin.ts",
    "./durable-db": "./src/server/durable-db.ts",
    "./env": "./env.ts",
    "./hardening-middleware": "./src/server/entries/hardening-middleware.ts",
    "./hub": "./src/server/hub.ts",
    "./interfaces": "./src/server/interfaces/index.ts",
    "./jobs": "./src/server/jobs.ts",
    "./kernel": "./src/server/kernel.ts",
    "./mail": "./src/server/entries/mail.ts",
    "./package.json": "./package.json",
    "./platform": {
      "workerd": "./src/platform/workers/index.ts",
      "default": "./src/platform/node/index.ts"
    },
    "./platform/email": {
      "workerd": "./src/platform/workers/email.ts",
      "default": "./src/platform/node/email.ts"
    },
    "./platform/raster": {
      "workerd": "./src/platform/workers/raster.ts",
      "default": "./src/platform/node/raster.ts"
    },
    "./plugin": "./hooks-plugin.ts",
    "./plugins": "./src/server/plugins/manifest.ts",
    "./plugins/ai": "./src/server/plugins/ai.ts",
    "./plugins/ai-binding": "./src/server/plugins/ai-binding.ts",
    "./plugins/auth": "./src/server/plugins/auth.ts",
    "./plugins/backups": "./src/server/plugins/backups.ts",
    "./plugins/collections": "./src/server/plugins/collections.ts",
    "./plugins/commerce": "./src/server/plugins/commerce.ts",
    "./plugins/domains": "./src/server/plugins/domains.ts",
    "./plugins/hardening": "./src/server/plugins/hardening.ts",
    "./plugins/lemonsqueezy": "./src/server/plugins/lemonsqueezy.ts",
    "./plugins/mail": "./src/server/plugins/mail.ts",
    "./plugins/mail-binding": "./src/server/plugins/mail-binding.ts",
    "./plugins/mcp": "./src/server/plugins/mcp.ts",
    "./plugins/observability": "./src/server/plugins/observability.ts",
    "./plugins/observability-binding": "./src/server/plugins/observability-binding.ts",
    "./plugins/openapi": "./src/server/plugins/openapi.ts",
    "./plugins/payments-shared": "./src/server/plugins/payments-shared.ts",
    "./plugins/polar": "./src/server/plugins/polar.ts",
    "./plugins/previews": "./src/server/plugins/previews.ts",
    "./plugins/realtime": "./src/server/plugins/realtime.ts",
    "./plugins/seo": "./src/server/plugins/seo.ts",
    "./plugins/seo-locales": "./src/server/plugins/seo-locales.ts",
    "./plugins/seo-paths": "./src/server/plugins/seo-paths.ts",
    "./plugins/shipping-flat": "./src/server/plugins/shipping-flat.ts",
    "./plugins/stripe": "./src/server/plugins/stripe.ts",
    "./plugins/tax-flat": "./src/server/plugins/tax-flat.ts",
    "./plugins/translations": "./src/server/plugins/translations.ts",
    "./project-sync": "./src/server/entries/project-sync.ts",
    "./realtime-client": "./src/server/entries/realtime-client.ts",
    "./realtime-slot": "./src/server/realtime-slot.ts",
    "./record-slot": "./src/server/record-slot.ts",
    "./records-files": "./src/server/entries/records-files.ts",
    "./records-preview": "./src/server/entries/records-preview.ts",
    "./registry": "./src/node/registry.ts",
    "./schema": "./db/schema.ts",
    "./scripts/export.ts": "./scripts/export.ts",
    "./scripts/sync-app.ts": "./scripts/sync-app.ts",
    "./scripts/sync-panel.ts": "./scripts/sync-panel.ts",
    "./sdk": "./src/server/entries/sdk.ts",
    "./secrets": "./src/env/define.ts",
    "./serve": "./src/node/serve.ts",
    "./static": "./src/server/static.ts",
    "./types": "./src/server/types.ts",
    "./workflows": "./src/server/workflows.ts"
  },
  "imports": {
    "#platform/env": {
      "workerd": "./src/platform/workers/env.ts",
      "default": "./src/platform/node/env.ts"
    },
    "#platform/log": {
      "workerd": "./src/platform/workers/log.ts",
      "default": "./src/platform/node/log.ts"
    },
    "#platform/sse": {
      "workerd": "./src/platform/workers/sse.ts",
      "default": "./src/platform/node/sse.ts"
    },
    "#platform/sockets": {
      "workerd": "./src/platform/workers/sockets.ts",
      "default": "./src/platform/node/sockets.ts"
    },
    "#platform/email": {
      "workerd": "./src/platform/workers/email.ts",
      "default": "./src/platform/node/email.ts"
    },
    "#platform/hooks": {
      "workerd": "./src/platform/workers/hooks.ts",
      "default": "./src/platform/node/hooks.ts"
    },
    "#platform/migrations": {
      "workerd": "./src/platform/workers/migrations.ts",
      "default": "./src/platform/node/migrations.ts"
    },
    "#platform/photon": {
      "workerd": "./src/platform/workers/photon.ts",
      "default": "./src/platform/node/photon.ts"
    },
    "#platform/plugins": {
      "workerd": "./src/platform/workers/plugins.ts",
      "default": "./src/platform/node/plugins.ts"
    },
    "#platform/raster": {
      "workerd": "./src/platform/workers/raster.ts",
      "default": "./src/platform/node/raster.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "db",
    "crons",
    "queues",
    "routes",
    "scripts/export.ts",
    "scripts/sync-panel.ts",
    "scripts/sync-app.ts",
    "scripts/seed-app-user.sh",
    "docs",
    "hooks-plugin.ts",
    "vite.config.ts",
    "void.json",
    "env.ts",
    ".env.example",
    "README.md",
    "COMPAT.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "types",
    "tsconfig.node.json"
  ],
  "keywords": [
    "pocketbase",
    "cloudflare-workers",
    "d1",
    "r2",
    "void",
    "backend",
    "baas"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "panel:sync": "bun scripts/sync-panel.ts",
    "app:sync": "bun scripts/sync-app.ts",
    "test": "bun test",
    "check": "void prepare && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "pack:check": "bun pm pack --dry-run",
    "prepublishOnly": "bun run check && bun test"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/workers-types": "^4.20250903.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@simplewebauthn/server": "^14.0.1",
    "@voidbase-cloud/plugin-ai": "workspace:*",
    "@voidbase-cloud/plugin-backups": "workspace:*",
    "@voidbase-cloud/plugin-domains": "workspace:*",
    "@voidbase-cloud/plugin-hardening": "workspace:*",
    "@voidbase-cloud/plugin-mail": "workspace:*",
    "@voidbase-cloud/plugin-mcp": "workspace:*",
    "@voidbase-cloud/plugin-observability": "workspace:*",
    "@voidbase-cloud/plugin-openapi": "workspace:*",
    "@voidbase-cloud/plugin-previews": "workspace:*",
    "@voidbase-cloud/plugin-realtime": "workspace:*",
    "@voidbase-cloud/plugin-seo": "workspace:*",
    "@voidbase-cloud/plugin-shipping-flat": "workspace:*",
    "@voidbase-cloud/plugin-tax-flat": "workspace:*",
    "@voidbase-cloud/plugin-translations": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cordis": "4.0.0-rc.9",
    "fflate": "^0.8.3",
    "hono": "^4.11.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-plus": "^0.1.21",
    "void": "^0.10.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.1",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "pocketbase": "0.28.0",
    "subset-font": "2.7.0"
  }
}
