{
  "name": "@voidbase-cloud/plugin-mail",
  "version": "0.9.0-beta.68",
  "description": "The mail plugin of voidbase: provides mail@1, the instance's own domain through Cloudflare Email Service",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidbase-cloud/voidbase.git",
    "directory": "packages/plugin-mail"
  },
  "homepage": "https://github.com/voidbase-cloud/voidbase/tree/master/packages/plugin-mail#readme",
  "bugs": {
    "url": "https://github.com/voidbase-cloud/voidbase/issues"
  },
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./main.d.ts",
      "default": "./main.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "main.js",
    "main.d.ts",
    "manifest.json",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "voidbase",
    "voidbase-plugin",
    "mail",
    "cloudflare-workers"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@voidbase-cloud/voidbase": "workspace:^"
  }
